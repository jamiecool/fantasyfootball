# Generated by build_clean_data.py — rebuildable offline from rawdata/
cleandata/fantasy.db
cleandata/csv/
cleandata/parquet/
cleandata/analysis/
cleandata/dashboard.html

# ...but these two are not generated output:
#   cleandata/README.md          schema documentation
#   cleandata/franchise_map.csv  hand-editable input

# Week-by-week nflverse stats: ~70MB of CSV that fetch_nflverse_weekly.py
# reproduces from a versioned GitHub release. The season files ARE tracked --
# they are 10x smaller and underpin final_ranks. Note the tradeoff: if nflverse
# revises a release, a future re-fetch may not reproduce today's numbers exactly.
rawdata/nflverse/stats_player_week_*.csv
# nflverse team-week stats (~230KB/season) and its games.csv mirror: the D/ST game
# logs. Same deal -- fetch_nflverse_team.py re-pulls anything missing.
rawdata/nflverse/stats_team_week_*.csv
rawdata/nflverse/games.csv

# nflverse games.csv: a 2.1MB full mirror re-downloaded on every fetch_vegas run,
# so it churns the whole file each time. Same call as the weekly stat lines --
# the script reproduces it, and a wholesale rewrite is the worst thing to have
# two people editing. team_week_implied.csv is derived from it.
rawdata/vegas/games.csv
rawdata/vegas/team_week_implied.csv

# serve.py keeps a one-deep backup each time the Save button writes the shared
# state. Local safety net, not history -- git already has that.
shared/*.bak
# Dated copies of every board-state save, kept 200 deep. Local safety net after a
# plan was lost to a single overwritten .bak -- git holds the history that is
# meant to be shared, this holds the one that stops an accident being permanent.
shared/history/
shared/*.tmp

# Excel lock files (created while a workbook is open)
~$*.xls*

# Yahoo OAuth — secrets, never commit
yahoo_credentials.json
yahoo_token.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# nflverse players.csv: 7MB reference file, 25k players, refetched by
# fetch_nflverse_players.py and only changing when someone enters the league.
# Same call as the other nflverse mirrors.
rawdata/nflverse/players.csv

# Personal notes for your own Claude sessions -- preferences, scratch, anything
# you do not want to negotiate with your partner. Claude Code reads it alongside
# CLAUDE.md but it never leaves your machine.
CLAUDE.local.md

# ESPN cookies (espn_s2 + SWID) -- secrets, never commit
espn_credentials.json

# The ESPN draft watcher's last snapshot (live_draft.py). Transient; ESPN has the record.
shared/live_draft.json
shared/live_draft.json.tmp
shared/init_undecoded_*.b64
